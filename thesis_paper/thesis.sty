\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/thesis}[2026/09/26 HSTU Thesis Professional Styling Package]

% Page geometry: 1.25 inch left for binding, 1.0 inch top/bottom/right
\RequirePackage[a4paper,top=1in,bottom=1in,left=1.25in,right=1in]{geometry}

% Mathematics
\RequirePackage{amsmath,amssymb,amsfonts,amsthm}
\RequirePackage{mathtools}
\RequirePackage{bm}

% Typography & Spacing (Times New Roman, 12pt)
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{setspace}
\onehalfspacing % Standard 1.5 line spacing for thesis

% Prevent text overflow into margins
\tolerance=2000
\emergencystretch=2.5em
\hfuzz=1pt

% Float placement parameters (prevents deferred figures from queuing up at chapter ends)
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.80}
\renewcommand{\textfraction}{0.15}
\renewcommand{\floatpagefraction}{0.70}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}

% Graphics & Colors
\RequirePackage{graphicx}
\RequirePackage{rotating}
\RequirePackage{xcolor}
\graphicspath{{figures/}{../figures/}}

% Color definitions
\definecolor{hstublue}{RGB}{0, 51, 102}
\definecolor{primaryblue}{RGB}{24, 76, 120}
\definecolor{darkblue}{RGB}{12, 44, 86}
\definecolor{accentred}{RGB}{178, 24, 43}
\definecolor{accentgreen}{RGB}{27, 120, 55}
\definecolor{codebg}{RGB}{248, 249, 250}
\definecolor{grayborder}{RGB}{220, 224, 230}

% Hyperlinks & URLs
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=darkblue,
    citecolor=primaryblue,
    urlcolor=accentred,
    bookmarksnumbered=true,
    pdfstartview={FitH}
}
\RequirePackage{xurl}
\RequirePackage[htt]{hyphenat}

% Allow line breaks after underscores in both normal text and \texttt
\DeclareRobustCommand{\_}{\textunderscore\allowbreak}

% Tables & Formatting
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small,labelfont=bf,margin=10pt}
\setlength{\tabcolsep}{5pt}

% Section Numbering Depth (up to subsubsection)
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

% Headings Formatting (HSTU Thesis Specification)
\RequirePackage{titlesec}

% Chapter Title: 16pt, Bold, Centered, Title Case
\titleformat{\chapter}[display]
  {\normalfont\fontsize{16pt}{20pt}\bfseries\centering}
  {\fontsize{16pt}{20pt}\bfseries\MakeUppercase{\chaptertitlename}\ \thechapter}
  {10pt}
  {\fontsize{16pt}{20pt}\bfseries}

\titleformat{name=\chapter,numberless}[block]
  {\normalfont\fontsize{16pt}{20pt}\bfseries\centering}
  {}
  {0pt}
  {\fontsize{16pt}{20pt}\bfseries}

\titlespacing*{\chapter}{0pt}{10pt}{22pt}
\titlespacing*{name=\chapter,numberless}{0pt}{10pt}{22pt}

% Heading 1 (Main Section): 14pt, Bold, Flush left, Title Case
\titleformat{\section}
  {\normalfont\fontsize{14pt}{18pt}\bfseries}
  {\thesection}
  {1em}
  {}
\titlespacing*{\section}{0pt}{16pt}{8pt}

% Heading 2 (Sub-heading): 12pt, Bold, Flush left, Title Case
\titleformat{\subsection}
  {\normalfont\fontsize{12pt}{15pt}\bfseries}
  {\thesubsection}
  {1em}
  {}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

% Heading 3 (Sub-sub-heading): 12pt, Italic, Flush left, Title Case
\titleformat{\subsubsection}
  {\normalfont\fontsize{12pt}{15pt}\itshape}
  {\thesubsubsection}
  {1em}
  {}
\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}

% Code listings & Algorithms
\RequirePackage{listings}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\lstset{
    backgroundcolor=\color{codebg},
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    frame=single,
    rulecolor=\color{grayborder},
    keywordstyle=\color{primaryblue}\bfseries,
    commentstyle=\color{accentgreen}\itshape,
    stringstyle=\color{accentred},
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    numbersep=8pt,
    showstringspaces=false,
    tabsize=2
}

% Theorem Environments
\theoremstyle{definition}
\newtheorem{definition}{Definition}[chapter]
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{lemma}{Lemma}[chapter]
\newtheorem{corollary}{Corollary}[chapter]
\newtheorem{proposition}{Proposition}[chapter]
\newtheorem{remark}{Remark}[chapter]
\newtheorem{example}{Example}[chapter]

% Headers and Footers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[LO]{\nouppercase{\rightmark}}
\fancyhead[RE]{\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\setlength{\headheight}{15pt}

% Bibliography styling
\RequirePackage[numbers,sort&compress]{natbib}
\bibliographystyle{IEEEtran}

\endinput
